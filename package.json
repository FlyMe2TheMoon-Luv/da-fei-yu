{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "桌面宠物：日程提醒 + 专注模式",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start-dev.js",
    "start:raw": "electron .",
    "test:schedules": "node scripts/test-schedules.js",
    "test:scheduler": "node scripts/test-scheduler.js",
    "test:reminder": "node scripts/test-reminder.js",
    "test:scheduler-e2e": "node scripts/start-dev.js --no-gpu --selftest=scheduler --isolated",
    "test:reminder-e2e": "node scripts/start-dev.js --no-gpu --selftest=reminder --isolated",
    "test:settings-e2e": "node scripts/start-dev.js --no-gpu --selftest=settings --isolated",
    "test:gaze": "node scripts/start-dev.js --no-gpu --selftest=gaze --isolated",
    "test:exit": "node scripts/start-dev.js --no-gpu --selftest=exit --isolated",
    "test:drag": "node scripts/start-dev.js --no-gpu --selftest=drag --isolated",
    "sync-vendor": "node scripts/sync-vendor.js",
    "patch-model": "node scripts/patch-model-expressions.js",
    "check-assets": "node scripts/check-assets.js",
    "make-tray-icon": "node scripts/make-tray-icon.js",
    "shot": "electron scripts/shot.js",
    "build": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  }
